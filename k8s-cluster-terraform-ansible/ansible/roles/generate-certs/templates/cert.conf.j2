[req]
prompt             = no
distinguished_name = dn

[dn]
C  = US
ST = Washington
L  = Seattle
O  = {{ item.org }}
CN = {{ item.cn }}

[v3_ext]
basicConstraints       = critical, CA:FALSE
keyUsage               = critical, digitalSignature, keyEncipherment
extendedKeyUsage       = {{ item.usage }}
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid, issuer
{% set dns_names = (item.dns | default([])) + (item.dns_extra | default([])) %}
{% set ip_addrs = item.ips | default([]) | unique %}
{% if dns_names or ip_addrs %}
subjectAltName         = @alt_names

[alt_names]
{% for name in dns_names %}
DNS.{{ loop.index }} = {{ name }}
{% endfor %}
{% for ip in ip_addrs %}
IP.{{ loop.index }} = {{ ip }}
{% endfor %}
{% endif %}
