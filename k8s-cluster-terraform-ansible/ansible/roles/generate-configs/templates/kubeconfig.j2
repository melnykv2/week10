apiVersion: v1
kind: Config
clusters:
  - name: {{ cluster_name }}
    cluster:
      certificate-authority-data: {{ lookup('ansible.builtin.file', pki_dir ~ '/ca.crt') | b64encode }}
      server: {{ item.server }}
users:
  - name: {{ item.user }}
    user:
      client-certificate-data: {{ lookup('ansible.builtin.file', pki_dir ~ '/' ~ item.cert ~ '.crt') | b64encode }}
      client-key-data: {{ lookup('ansible.builtin.file', pki_dir ~ '/' ~ item.cert ~ '.key') | b64encode }}
contexts:
  - name: default
    context:
      cluster: {{ cluster_name }}
      user: {{ item.user }}
current-context: default
